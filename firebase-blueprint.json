{
  "entities": {
    "TrafficEvent": {
      "title": "TrafficEvent",
      "description": "Page view and traffic monitoring events logged for analytics.",
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "maxLength": 64,
          "description": "Unique client session identifier."
        },
        "path": {
          "type": "string",
          "maxLength": 128,
          "description": "The page path visited."
        },
        "referrer": {
          "type": "string",
          "maxLength": 256,
          "description": "Document referrer or direct entry."
        },
        "userAgent": {
          "type": "string",
          "maxLength": 256,
          "description": "Client device or browser family."
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when event was recorded."
        }
      },
      "required": ["sessionId", "path", "timestamp"]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "Client and recruiter inquiries submitted through the portfolio contact form.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 100,
          "description": "Sender full name."
        },
        "email": {
          "type": "string",
          "maxLength": 150,
          "description": "Sender email address."
        },
        "subject": {
          "type": "string",
          "maxLength": 200,
          "description": "Inquiry subject or project scope."
        },
        "message": {
          "type": "string",
          "maxLength": 3000,
          "description": "Inquiry message content."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp."
        },
        "status": {
          "type": "string",
          "enum": ["unread", "read", "archived"],
          "description": "Inquiry status."
        }
      },
      "required": ["name", "email", "message", "createdAt", "status"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile data for authenticated visitors or the portfolio owner.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "description": "Firebase Auth UID."
        },
        "email": {
          "type": "string",
          "maxLength": 150,
          "description": "User email address."
        },
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "User display name."
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "User avatar photo URL."
        },
        "role": {
          "type": "string",
          "enum": ["visitor", "admin"],
          "description": "Access control role."
        },
        "lastLoginAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of most recent login."
        }
      },
      "required": ["uid", "email", "role"]
    }
  },
  "firestore": {
    "/traffic/{eventId}": {
      "schema": "TrafficEvent",
      "description": "Collection of visitor traffic events for portfolio monitoring."
    },
    "/inquiries/{inquiryId}": {
      "schema": "Inquiry",
      "description": "Collection of contact form submissions from clients and recruiters."
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Collection of authenticated user profiles."
    }
  }
}
