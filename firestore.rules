rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email == 'zaim98269@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validation Helpers ---
    function isValidTraffic(data) {
      return data.keys().hasAll(['sessionId', 'path', 'timestamp']) &&
        data.keys().hasOnly(['sessionId', 'path', 'referrer', 'userAgent', 'timestamp']) &&
        data.sessionId is string && data.sessionId.size() > 0 && data.sessionId.size() <= 64 &&
        data.path is string && data.path.size() > 0 && data.path.size() <= 128 &&
        (!('referrer' in data) || (data.referrer is string && data.referrer.size() <= 256)) &&
        (!('userAgent' in data) || (data.userAgent is string && data.userAgent.size() <= 256)) &&
        data.timestamp == request.time;
    }

    function isValidInquiry(data) {
      return data.keys().hasAll(['name', 'email', 'message', 'createdAt', 'status']) &&
        data.keys().hasOnly(['name', 'email', 'subject', 'message', 'createdAt', 'status']) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.email is string && data.email.size() > 3 && data.email.size() <= 150 &&
        (!('subject' in data) || (data.subject is string && data.subject.size() <= 200)) &&
        data.message is string && data.message.size() > 0 && data.message.size() <= 3000 &&
        data.status in ['unread', 'read', 'archived'] &&
        data.createdAt == request.time;
    }

    function isValidUser(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'role', 'lastLoginAt']) &&
        data.uid == userId && data.uid == request.auth.uid &&
        data.email is string && data.email == request.auth.token.email &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        (
          (data.role == 'visitor') ||
          (data.role == 'admin' && isAdmin())
        );
    }

    // --- Traffic Events Collection ---
    match /traffic/{eventId} {
      // Anyone can log a page view / traffic beacon
      allow create: if isValidId(eventId) && isValidTraffic(incoming());
      
      // Only the admin can inspect analytics and traffic logs
      allow read, list, update, delete: if isAdmin();
    }

    // --- Inquiries Collection (Contact Form) ---
    match /inquiries/{inquiryId} {
      // Anyone can submit a client inquiry via the contact form
      allow create: if isValidId(inquiryId) && isValidInquiry(incoming()) && incoming().status == 'unread';

      // Only admin (Zain) can read, list, or update inquiry status
      allow read, list, delete: if isAdmin();
      allow update: if isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
        incoming().status in ['unread', 'read', 'archived'];
    }

    // --- User Profiles Collection ---
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming(), userId);
      allow update: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email;
    }

    // Connection test document
    match /test/{docId} {
      allow read: if true;
    }
  }
}
